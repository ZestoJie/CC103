{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run CC103 JavaFX App",
            "request": "launch",
            "mainClass": "com.cc103sys.cc103.App",
            "projectName": "CC103_Client",
            "vmArgs": "--module-path \"${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-base/21.0.10/javafx-base-21.0.10-win.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-graphics/21.0.10/javafx-graphics-21.0.10-win.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-controls/21.0.10/javafx-controls-21.0.10-win.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-fxml/21.0.10/javafx-fxml-21.0.10-win.jar\" --add-modules javafx.controls,javafx.fxml"
        }
    ]
}
