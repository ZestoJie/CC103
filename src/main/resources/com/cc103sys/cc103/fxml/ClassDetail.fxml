<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefWidth="973.0" spacing="20" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.ClassDetailController">

    <children>
        <fx:include source="navbar.fxml"/>

        <ScrollPane fitToWidth="true" fitToHeight="false" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="20" style="-fx-padding: 20;">
                    <children>
                        <Label fx:id="breadcrumbLabel" styleClass="breadcrumb" text="Dashboard › Classes" />

                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-wrap-text: true;">
                    <children>
                        <Button onAction="#goBack" styleClass="button-secondary" text="← Back to Classes" />
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="classTitleLabel" styleClass="heading-1" text="Class Name" />
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="classCodeLabel" styleClass="subtitle" text="Code: N/A" />
                                        <Label fx:id="classVisibilityLabel" styleClass="status-badge status-badge-neutral" text="Visibility" />
                                        <Label fx:id="classMetricsLabel" styleClass="subtitle" text="—" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="12" styleClass="card">
                    <children>
                        <Label text="Class Information" styleClass="heading-3" />
                        <Label fx:id="classDescriptionLabel" styleClass="body" text="Class description will appear here..." />
                    </children>
                </VBox>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <children>
                        
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Class Tasks" styleClass="heading-2" />
                                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox spacing="12" styleClass="card">
                                            <children>
                                                <ListView fx:id="tasksListView" prefHeight="400" minHeight="120" />
                                                <HBox fx:id="ownerTaskActionsRow" spacing="10">
                                                    <children>
                                                        <Button fx:id="editTaskButton" onAction="#handleEditTask" text="Edit Selected Task" styleClass="button-secondary" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="deleteTaskButton" onAction="#handleDeleteTask" text="Delete Selected Task" styleClass="button-danger" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        
                        <VBox prefWidth="350" spacing="15" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="participantTaskHint" managed="false" visible="false" styleClass="subtitle" wrapText="true" text="You can view tasks and open each one to submit work. Only the class host can add or edit class tasks here." />

                                <Label fx:id="formTitleLabel" styleClass="heading-2" text="Add New Task" />
                                <VBox fx:id="ownerTaskFormCard" spacing="12" styleClass="card">
                                    <children>
                                        <Label text="Task Title *" styleClass="caption" />
                                        <TextField fx:id="taskTitleField" promptText="Enter task title" />

                                        <Label text="Description" styleClass="caption" />
                                        <TextArea fx:id="taskDescriptionArea" prefRowCount="3" promptText="Enter task description (optional)" wrapText="true" />

                                        <Label text="Due Date *" styleClass="caption" />
                                        <DatePicker fx:id="taskDueDatePicker" />

                                        <Label text="Attachment (Optional)" styleClass="caption" />
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="attachmentField" promptText="No file selected" editable="false" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="uploadAttachmentButton" onAction="#handleUploadAttachment" text="Browse" styleClass="button-secondary" />
                                            </children>
                                        </HBox>

                                        <HBox spacing="10">
                                            <children>
                                                <Button fx:id="submitTaskButton" onAction="#handleSubmitTask" text="Add Task" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="cancelEditButton" managed="false" onAction="#handleCancelEdit" styleClass="button-secondary" text="Cancel" visible="false" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="12" styleClass="card">
                                    <children>
                                        <Label text="Class Participants" styleClass="heading-3" />
                                        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                            <content>
                                                <VBox spacing="8" style="-fx-padding: 0;">
                                                    <children>
                                                        <ListView fx:id="participantsListView" prefHeight="180" />
                                                    </children>
                                                </VBox>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
            </content>
        </ScrollPane>
    </children>
</HBox>
