<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: #f8fbff;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cc103sys.cc103.Controllers.ClassesController">

    <children>

        <!-- Navbar -->
        <fx:include source="navbar.fxml" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"/>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;" AnchorPane.leftAnchor="230" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
            <content>

                <VBox prefWidth="1300.0" spacing="24">
                    <padding>
                        <Insets top="28" right="28" bottom="28" left="28"/>
                    </padding>

                    <!-- Header -->
                    <VBox spacing="8">
                        <Label text="Classes" styleClass="heading-1"/>
                        <Label text="Manage and explore classes" styleClass="subtitle"/>
                    </VBox>

                    <HBox spacing="20" VBox.vgrow="ALWAYS">

                        <!-- LEFT COLUMN -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">

                            <!-- Create Class -->
                            <VBox spacing="14" styleClass="card">
                                <children>
                                    <Label text="Create Class" styleClass="heading-3"/>
                                    <Separator/>

                                    <Label text="Class Name"/>
                                    <TextField fx:id="classNameField" promptText="My New Class"/>

                                    <Label text="Class Visibility"/>
                                    <ToggleButton fx:id="publicClassToggle" text="Private"/>

                                    <Button text="Create Class" onAction="#createClass"/>

                                    <Label fx:id="generatedCodeLabel"
                                           visible="false"
                                           text="Class Code:"/>

                                    <Button fx:id="copyCodeButton"
                                            visible="false"
                                            text="Copy Code"
                                            onAction="#copyCode"/>

                                    <Label text="Public classes appear in list; private classes require code."
                                           wrapText="true"/>
                                </children>
                            </VBox>

                            <!-- Join Class -->
                            <VBox spacing="14" styleClass="card">
                                <children>
                                    <Label text="Join Private Class" styleClass="heading-3"/>
                                    <Separator/>

                                    <Label text="Enter Class Code"/>
                                    <TextField fx:id="codeField" promptText="e.g., ABC123"/>

                                    <Button text="Join Class" onAction="#joinPrivateClass"/>
                                </children>
                            </VBox>

                            <!-- Public Classes -->
                            <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="Public Classes" styleClass="heading-3"/>
                                    <Separator/>

                                    <ListView fx:id="classList" VBox.vgrow="ALWAYS"/>
                                </children>
                            </VBox>

                        </VBox>

                        <!-- RIGHT COLUMN -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">

                            <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="My Classes" styleClass="heading-3"/>
                                    <Separator/>

                                    <ListView fx:id="myClassList" VBox.vgrow="ALWAYS"/>
                                </children>
                            </VBox>

                        </VBox>

                    </HBox>

                </VBox>

            </content>
        </ScrollPane>

    </children>
</AnchorPane>