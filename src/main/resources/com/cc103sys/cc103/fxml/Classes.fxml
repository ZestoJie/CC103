<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="20" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.ClassesController" HBox.hgrow="ALWAYS">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <children>
        <!-- Navbar (Fixed Width) -->
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>

        <VBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <children>
                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <!-- LEFT COLUMN - AVAILABLE CLASSES AND CREATE CARD -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Available Classes" />
                                        <Button fx:id="addClassButton" onAction="#toggleCreateSection" mnemonicParsing="false" style="-fx-background-color: #f5f7fb; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 18; -fx-font-size: 13;" text="Add +" />
                                    </children>
                                </HBox>
                                <VBox fx:id="createClassSection" spacing="14" style="-fx-background-color: white; -fx-padding: 18; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                    <children>
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Create Class" />
                                        <Label style="-fx-font-size: 12;" text="Class Name" />
                                        <TextField fx:id="classNameField" promptText="My New Class" />
                                        <CheckBox fx:id="publicClassCheckbox" text="Public class" />
                                        <Label style="-fx-font-size: 12;" text="Private class code" />
                                        <TextField fx:id="privateClassCodeField" promptText="Custom code (6-10 chars)" />
                                        <Button onAction="#createClass" style="-fx-font-size: 14; -fx-background-radius: 20;" text="Create Class" />
                                        <Label style="-fx-font-size: 13; -fx-text-fill: #666;" text="Public classes appear in list; private classes require code." wrapText="true" />
                                    </children>
                                </VBox>
                                <VBox spacing="14" style="-fx-background-color: white; -fx-padding: 18; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                    <children>
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Join Private Class" />
                                        <Label style="-fx-font-size: 12;" text="Enter Class Code" />
                                        <TextField fx:id="codeField" promptText="e.g., ABC123" />
                                        <Button onAction="#joinPrivateClass" style="-fx-font-size: 14; -fx-background-radius: 20;" text="Join Class" />
                                    </children>
                                </VBox>
                                <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                                    <content>
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 18; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                            <children>
                                                <VBox spacing="10" style="-fx-padding: 25 25 10 25;">
                                                    <Label text="Available Public Classes" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                                </VBox>
                                                <!-- Clean List View -->
                                                <ListView fx:id="classList" VBox.vgrow="ALWAYS" 
                                                          style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10 10 10;" />
                                            </children>
                                        </VBox>

                                    </VBox>
                                    
                                    <!-- RIGHT COLUMN: My Classes -->
                                    <VBox spacing="25" HBox.hgrow="ALWAYS">
                                        
                                        <!-- CARD: My Classes -->
                                        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 0; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);" VBox.vgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="10" style="-fx-padding: 25 25 10 25;">
                                                    <Label text="My Classes" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                                    <Label text="Classes you have joined or created" style="-fx-font-size: 13; -fx-text-fill: #95a5a6;" />
                                                </VBox>
                                                <!-- Clean List View -->
                                                <ListView fx:id="myClassList" VBox.vgrow="ALWAYS" 
                                                          style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10 10 10;" />
                                            </children>
                                        </VBox>
                                        
                                    </VBox>
                                    
                                </HBox>
                                
                                <!-- Footer Spacer -->
                                <Region prefHeight="20" />
                                
                            </VBox>
                        </HBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>