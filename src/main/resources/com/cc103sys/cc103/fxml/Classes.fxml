<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Root Container: Sidebar + Main Content -->

<HBox spacing="0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.ClassesController">
    <children>
        <!-- Navbar (Fixed Width) -->
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER" />
        
        <!-- Main Content Area -->
        <VBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>
            
            <children>
                <!-- Header Section (Stays Fixed) -->
                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <children>
                            <Label style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Classes" />
                            <Button fx:id="tabAllClassesBtn" onAction="#switchToAllClassesView" style="-fx-background-color: white; -fx-text-fill: #718096; -fx-border-color: #e2e8f0; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 20; -fx-font-weight: 600; -fx-cursor: hand;" text="All Classes" />
                            <Button fx:id="tabDetailBtn" disable="true" onAction="#switchToDetailView" style="-fx-background-color: white; -fx-text-fill: #cbd5e0; -fx-border-color: #e2e8f0; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 20; -fx-font-weight: 600; -fx-cursor: default;" text="Class Details" />
                            
                                  <!-- Create Class Button (Host Only) -->
                            <Button fx:id="addClassButton" onAction="#toggleCreateSection" style="-fx-background-color: #f0d045; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10px 20px; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(49, 130, 206, 0.3), 6, 0, 0, 0);" text="Create New Class">
                            </Button>
                        </children>
                    </HBox>

                    <!-- Custom Tab Navigation (Replaces TabPane) -->
                    <HBox alignment="CENTER_LEFT" spacing="10" />
                </VBox>

                <!-- SCROLLABLE CONTENT AREA -->
                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                    <content>
                        <!-- Container with MaxWidth to prevent stretching on ultrawide screens -->
                        <HBox alignment="TOP_CENTER">
                            <VBox fillWidth="true" maxWidth="900" spacing="25" HBox.hgrow="ALWAYS">
                                
                                <!-- VIEW 1: All Classes List -->
                                <VBox fx:id="allClassesView" spacing="25">
                                    
                                    <!-- Create Class Panel (Hidden by default) -->
                                    <VBox fx:id="createClassSection" prefHeight="246.0" prefWidth="522.0" spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10">
                                                <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Create New Class" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button onAction="#toggleCreateSection" style="-fx-background-color: transparent; -fx-text-fill: #a0aec0; -fx-cursor: hand; -fx-font-size: 16;" text="✕" />
                                            </HBox>
                                            
                                            <VBox spacing="5">
                                                <Label style="-fx-font-size: 13; -fx-text-fill: #718096;" text="Class Name" />
                                                <TextField fx:id="classNameField" promptText="e.g., CS101 - Intro to Programming" style="-fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #ffffff;" />
                                            </VBox>
                                            
                                            <HBox alignment="CENTER_LEFT" spacing="15">
                                                <CheckBox fx:id="publicClassCheckbox" style="-fx-font-size: 14; -fx-text-fill: #4a5568;" text="Public Class" />
                                            </HBox>
                                            
                                            <VBox spacing="5">
                                                <Label style="-fx-font-size: 13; -fx-text-fill: #718096;" text="Private Code (Optional)" />
                                                <TextField fx:id="privateClassCodeField" promptText="Leave blank to auto-generate" style="-fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #ffffff;" />
                                            </VBox>

                                            <Button onAction="#createClass" style="-fx-background-color: linear-gradient(#0a1f2e, #163a52); -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" text="Create Class" HBox.hgrow="ALWAYS" />
                                        </children>
                                    </VBox>
                                    
                                    <!-- Join Private Class Card -->
                                    <VBox spacing="15" style="-fx-background-color: linear-gradient(#0a1f2e, #163a52); -fx-padding: 25; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                        <children>
                                            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="Join Private Class" />
                                            <HBox spacing="10">
                                                <TextField fx:id="codeField" promptText="Enter Code (e.g. ABC123)" style="-fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #ffffff;" HBox.hgrow="ALWAYS" />
                                                <Button onAction="#joinPrivateClass" prefHeight="42.0" prefWidth="96.0" style="-fx-background-color: #ffcc00; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 0 25; -fx-font-weight: bold; -fx-cursor: hand;" text="Join" />
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <!-- Main Grid -->
                                    <HBox spacing="25">
                                        
                                        <!-- Left: Available Classes -->
                                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                                            <Label contentDisplay="TOP" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Available Public Classes" />
                                            <VBox minHeight="400" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                    <BorderPane VBox.vgrow="ALWAYS">
                                       <center>
                                                      <ListView fx:id="classList" prefHeight="400.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-border-radius: 50;" />
                                       </center>
                                    </BorderPane>
                                            </VBox>
                                        </VBox>
                                        
                                        <!-- Right: My Classes -->
                                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="My Classes" />
                                            <VBox minHeight="400" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                    <BorderPane VBox.vgrow="ALWAYS">
                                       <center>
                                                      <ListView fx:id="myClassList" prefHeight="400.0" style="-fx-background-color: Transparent; -fx-border-color: transparent; -fx-border-radius: 50;" />
                                       </center>
                                    </BorderPane>
                                            </VBox>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <!-- VIEW 2: Class Detail (Hidden by default) -->
                                <VBox fx:id="classDetailView" managed="false" spacing="25" visible="false">
                                    
                                    <HBox alignment="CENTER_LEFT" spacing="20">
                                        <children>
                                            <Button onAction="#goBackToClasses" style="-fx-background-color: transparent; -fx-text-fill: #718096; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: 600; -fx-padding: 5 0;" text="← Back" />
                                            <Label fx:id="detailClassTitleLabel" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Class Detail" />
                                        </children>
                                    </HBox>

                                    <!-- Description Card -->
                                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                        <children>
                                            <Label style="-fx-font-size: 13; -fx-text-fill: #718096; -fx-font-weight: bold;" text="About this class" />
                                            <Label fx:id="detailClassDescriptionLabel" style="-fx-font-size: 14; -fx-text-fill: #4a5568; -fx-line-spacing: 4;" text="Class description..." wrapText="true" />
                                        </children>
                                    </VBox>

                                    <!-- Detail Content Grid -->
                                    <HBox spacing="25">
                                        
                                        <!-- Left: Task List -->
                                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Class Tasks" />
                                            <VBox minHeight="500" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                                <ListView fx:id="detailTasksListView" prefHeight="500" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS" />
                                            </VBox>
                                        </VBox>
                                        
                                        <!-- Right: Management & Form -->
                                        <VBox prefWidth="350" spacing="25">
                                            
                                            <!-- Manage Selection -->
                                            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                                <children>
                                                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Manage Selection" />
                                                    <VBox spacing="10">
                                                        <Button fx:id="detailEditTaskButton" onAction="#handleDetailEditTask" style="-fx-background-color: #f0d04f5; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-font-weight: 600; -fx-cursor: hand;" text="Edit Task" />
                                                        <Button fx:id="detailDeleteTaskButton" onAction="#handleDetailDeleteTask" style="-fx-background-color: #e53e3e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-font-weight: 600; -fx-cursor: hand;" text="Delete Task" />
                                                    </VBox>
                                                </children>
                                            </VBox>
                                            
                                            <!-- Task Form -->
                                            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                                <children>
                                                    <Label fx:id="detailFormTitleLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Add New Task" />
                                                    
                                                    <VBox spacing="5">
                                                        <Label style="-fx-font-size: 13; -fx-text-fill: #718096;" text="Task Title" />
                                                        <TextField fx:id="detailTaskTitleField" promptText="Task name" style="-fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #ffffff;" />
                                                    </VBox>
                                                    
                                                    <VBox spacing="5">
                                                        <Label style="-fx-font-size: 13; -fx-text-fill: #718096;" text="Description" />
                                                        <TextArea fx:id="detailTaskDescriptionArea" prefRowCount="3" promptText="Details..." style="-fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #ffffff;" wrapText="true" />
                                                    </VBox>
                                                    
                                                    <VBox spacing="5">
                                                        <Label style="-fx-font-size: 13; -fx-text-fill: #718096;" text="Due Date" />
                                                        <DatePicker fx:id="detailTaskDueDatePicker" style="-fx-padding: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #ffffff;" />
                                                    </VBox>

                                                    <HBox spacing="10">
                                                        <Button fx:id="detailSubmitTaskButton" onAction="#handleDetailSubmitTask" style="-fx-background-color: #3182ce; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-font-weight: 600; -fx-cursor: hand;" text="Add Task" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="detailCancelEditButton" managed="false" onAction="#handleDetailCancelEdit" style="-fx-background-color: #edf2f7; -fx-text-fill: #718096; -fx-background-radius: 8; -fx-padding: 10; -fx-font-weight: 600; -fx-cursor: hand;" text="Cancel" visible="false" HBox.hgrow="ALWAYS" />
                                                    </HBox>
                                                </children>
                                            </VBox>

                                            <!-- Participants -->
                                            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                                                <children>
                                                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Participants" />
                                                    <VBox minHeight="200" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;">
                                                        <ListView fx:id="detailParticipantsListView" prefHeight="200" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS" />
                                                    </VBox>
                                                </children>
                                            </VBox>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                
                            </VBox>
                        </HBox>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</HBox>
