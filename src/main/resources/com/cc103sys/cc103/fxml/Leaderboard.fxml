<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.LeaderboardController" style="-fx-background-color: #f8fafc;" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
    <children>
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>
        
        <VBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <Label text="Leaderboard" styleClass="heading-1" />

                <HBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- CLASS LEADERBOARD -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="card">
                            <children>
                                <Label text="Class Rankings" styleClass="heading-2" />
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Select Class:" styleClass="caption" />
                                        <ComboBox fx:id="classComboBox" promptText="Select Class" HBox.hgrow="ALWAYS"/>
                                        <Button text="View" onAction="#loadLeaderboard" />
                                    </children>
                                </HBox>
                                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="table" visible="false" style="-fx-font-size: 12;">
                                        <columns>
                                            <TableColumn fx:id="usernameCol" text="Student Name" prefWidth="220" />
                                            <TableColumn fx:id="pointsCol" text="Total XP (Points)" prefWidth="150" />
                                            <TableColumn fx:id="levelCol" text="Level" prefWidth="100" />
                                        </columns>
                                    </TableView>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- OVERALL LEADERBOARD -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="card">
                            <children>
                                <Label text="Global Rankings" styleClass="heading-2" />
                                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="overallTable" style="-fx-font-size: 12;">
                                        <columns>
                                            <TableColumn fx:id="overallUsernameCol" text="Student Name" prefWidth="220" />
                                            <TableColumn fx:id="overallPointsCol" text="Total XP (Points)" prefWidth="150" />
                                            <TableColumn fx:id="overallLevelCol" text="Level" prefWidth="100" />
                                        </columns>
                                    </TableView>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Button text="Back to Dashboard" onAction="#goBack" styleClass="button-secondary" />
            </children>
        </VBox>
    </children>
</HBox>