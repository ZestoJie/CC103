<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="60.0" prefWidth="1440.0" style="-fx-padding: 10 20 10 20; -fx-background-color: #2c3e50; -fx-border-color: #34495e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.NavbarController">
    <children>
        <Button text="Tasks" onAction="#goTasks" style="-fx-padding: 10 15 10 15; -fx-font-size: 12; -fx-text-fill: white;" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="20" />
        <Button text="Dashboard" onAction="#goDashboard" style="-fx-padding: 10 15 10 15; -fx-font-size: 12; -fx-text-fill: white;" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="100" />
        <Button text="Classes" onAction="#goClasses" style="-fx-padding: 10 15 10 15; -fx-font-size: 12; -fx-text-fill: white;" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="200" />
        <Button text="Leaderboard" onAction="#goLeaderboard" style="-fx-padding: 10 15 10 15; -fx-font-size: 12; -fx-text-fill: white;" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="300" />
        <Button text="Logout" onAction="#logout" style="-fx-padding: 10 15 10 15; -fx-font-size: 12; -fx-text-fill: white; -fx-background-color: #e74c3c;" AnchorPane.topAnchor="10" AnchorPane.rightAnchor="20" />
    </children>
</AnchorPane>
