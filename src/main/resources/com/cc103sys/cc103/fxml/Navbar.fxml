<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="230" spacing="15" style="-fx-background-color: linear-gradient(#0a1f2e, #163a52); -fx-padding: 20;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.NavbarController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <ImageView fitHeight="35" fitWidth="35" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
            <image>
                <Image url="@../../../../images/logowhite.png" />
            </image>
        </ImageView>

        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="KyusiyuVenture" />
    </HBox>

    <VBox alignment="CENTER" spacing="8">
        <ImageView fx:id="profilePictureImageView" fitHeight="35" fitWidth="35" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
            <image>
                <Image url="@/images/logowhite.png" />
            </image>
        </ImageView>

        <Label fx:id="usernameLabel" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Username" />

        <Label fx:id="userRoleLabel" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px;" text="Participant" />

        <ProgressBar fx:id="levelProgressBar" prefWidth="120" progress="0.0" style="-fx-accent: #facc15;" />

        <Label fx:id="levelLabel" style="-fx-text-fill: white; -fx-font-size: 12px;" text="Level 1" />        <Label text="Active Timer" style="-fx-text-fill: #cbd5e1; -fx-font-size: 11;" />
        <Label fx:id="timerStatusLabel" text="No active timer" style="-fx-text-fill: white; -fx-font-size: 12;" />
        <Label fx:id="timerValueLabel" text="00:00" style="-fx-text-fill: #facc15; -fx-font-size: 14; -fx-font-weight: bold;" />    </VBox>

    <VBox spacing="12">

        <Button fx:id="dashboardBtn" contentDisplay="LEFT" graphicTextGap="10" maxWidth="Infinity" onAction="#goDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;" text="Dashboard">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@../../../../images/icon-dashboard.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="classesBtn" contentDisplay="LEFT" graphicTextGap="10" maxWidth="Infinity" onAction="#goClasses" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;" text="Classes">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@../../../../images/icon-class.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="leaderboardBtn" contentDisplay="LEFT" graphicTextGap="10" maxWidth="Infinity" onAction="#goLeaderboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;" text="Leaderboard">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@../../../../images/icon-lboard.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="tasksBtn" contentDisplay="LEFT" graphicTextGap="10" maxWidth="Infinity" onAction="#goTasks" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;" text="Tasks">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@../../../../images/icon-tasks.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="settingsBtn" contentDisplay="LEFT" graphicTextGap="10" maxWidth="Infinity" onAction="#goSettings" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;" text="Settings">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@../../../../images/icon-settings.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <Button contentDisplay="LEFT" graphicTextGap="10" maxWidth="Infinity" onAction="#logout" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;" text="Logout">
        <graphic>
            <ImageView fitHeight="20.0" fitWidth="20.0" style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                <image>
                    <Image url="@../../../../images/icon-logout.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

</VBox>
