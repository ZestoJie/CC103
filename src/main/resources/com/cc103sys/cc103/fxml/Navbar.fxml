<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="230" spacing="15" VBox.vgrow="ALWAYS"
      style="-fx-background-color: linear-gradient(#0a1f2e, #163a52); -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cc103sys.cc103.Controllers.NavbarController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <ImageView fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
            <image>
                <Image url="@/images/logowhite.png"/>
            </image>
        </ImageView>

        <Label text="KyusiyuVenture"
               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;"/>
    </HBox>

    <VBox alignment="CENTER" spacing="8">
        <ImageView fx:id="profilePictureImageView" fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
            <image>
                <Image url="@/images/logowhite.png"/>
            </image>
        </ImageView>

        <Label fx:id="usernameLabel" text="Username"
               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />

        <Label fx:id="userRoleLabel" text="Participant"
               style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px;" />

        <ProgressBar fx:id="levelProgressBar" progress="0.0" prefWidth="120"
                     style="-fx-accent: #facc15;" />

        <Label fx:id="levelLabel" text="Level 1"
               style="-fx-text-fill: white; -fx-font-size: 12px;" />
    </VBox>

    <!-- Timer Display (Persistent) -->
    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #1e3a52; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
        <Label fx:id="timerStatusLabel" text="Timer Inactive"
               style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;" />
        <Label fx:id="timerDisplayLabel" text="--:--"
               style="-fx-text-fill: #00ff00; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" />
        <HBox alignment="CENTER" spacing="5">
            <Button fx:id="timerPauseBtn" text="Pause" prefWidth="50" 
                    style="-fx-font-size: 10px; -fx-padding: 5;" onAction="#handleTimerPause" />
            <Button fx:id="timerStopBtn" text="Stop" prefWidth="50"
                    style="-fx-font-size: 10px; -fx-padding: 5;" onAction="#handleTimerStop" />
        </HBox>
    </VBox>

    <VBox spacing="12">

        <Button fx:id="dashboardBtn" text="Dashboard" onAction="#goDashboard"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="10"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;">
            <graphic>
                <ImageView fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@/images/icon-dashboard.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="classesBtn" text="Classes" onAction="#goClasses"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="10"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;">
            <graphic>
                <ImageView fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@/images/icon-class.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="leaderboardBtn" text="Leaderboard" onAction="#goLeaderboard"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="10"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;">
            <graphic>
                <ImageView fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@/images/icon-lboard.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="tasksBtn" text="Tasks" onAction="#goTasks"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="10"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;">
            <graphic>
                <ImageView fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@/images/icon-tasks.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="settingsBtn" text="Settings" onAction="#goSettings"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="10"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;">
            <graphic>
                 <ImageView fitHeight="35" fitWidth="35"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                    <image>
                        <Image url="@/images/icon-settings.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Button text="Logout" onAction="#logout"
            maxWidth="Infinity"
            contentDisplay="LEFT"
            graphicTextGap="10"
            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 8 12; -fx-alignment: CENTER_LEFT;">
        <graphic>
            <ImageView fx:id="logoutIconImageView" fitHeight="20" fitWidth="20"
                   style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: white; -fx-border-width: 2;">
                <image>
                    <Image url="@/images/icon-logout.png"/>
                </image>
            </ImageView>
        </graphic>
    </Button>

</VBox>