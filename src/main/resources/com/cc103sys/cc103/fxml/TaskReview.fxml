<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<HBox prefWidth="973.0" spacing="20" style="-fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.TaskReviewController">

    <children>
        <fx:include source="navbar.fxml"/>

        <VBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">
            <children>
                <Label fx:id="breadcrumbLabel" styleClass="breadcrumb" text="Dashboard › Classes" />

                
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <children>
                        <Button fx:id="backButton" onAction="#handleGoBack" styleClass="button-secondary" text="← Back to Class" />
                        <Label fx:id="classNameLabel" styleClass="subtitle" text="Class Name" />
                    </children>
                </HBox>

                
                <VBox spacing="12" styleClass="card">
                    <children>
                        <Label fx:id="taskTitleLabel" styleClass="heading-1" text="Task Title" />
                        <Label fx:id="dueDateLabel" styleClass="subtitle" text="Due Date" />
                        <Label text="Task Description" styleClass="heading-3" />
                        <TextArea fx:id="taskDescriptionArea" wrapText="true" prefRowCount="6" style="-fx-control-inner-background: #f1f5f9; -fx-text-fill: #1e293b;" />
                    </children>
                </VBox>

                
                <VBox spacing="15" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label text="Student Submissions" styleClass="heading-2" />
                                <Label fx:id="submissionCountLabel" styleClass="subtitle" text="Total Submissions: 0" />
                            </children>
                        </HBox>

                        <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <ListView fx:id="submissionsListView" style="-fx-background-color: transparent;" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
