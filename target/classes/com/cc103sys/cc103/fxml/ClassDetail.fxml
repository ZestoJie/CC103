<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- Root Container: Sidebar + Main Content -->
<HBox spacing="0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.cc103sys.cc103.Controllers.ClassDetailController" 
      style="-fx-background-color: #f0f2f5;">
    <children>
        <!-- Navbar (Fixed Width) -->
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>
        
        <!-- Main Content Area -->
        <VBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>
            
            <children>
                <!-- Header: Back Button + Title -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-pref-width: 900;">
                    <children>
                        <Button onAction="#goBack" text="← Back to Classes" 
                                style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: 600; -fx-padding: 5 0;" />
                        <Label fx:id="classTitleLabel" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Class Name" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="25" />
                    </VBox.margin>
                </HBox>
                
                <!-- Scrollable Content -->
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" 
                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                    <content>
                        <!-- Max Width Container for Desktop Sizing -->
                        <HBox alignment="TOP_CENTER">
                            <VBox spacing="25" maxWidth="900" HBox.hgrow="ALWAYS" fillWidth="true">
                                
                                <!-- Class Description Card (Full Width) -->
                                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);">
                                    <children>
                                        <Label style="-fx-font-size: 14; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="About this class" />
                                        <Label fx:id="classDescriptionLabel" style="-fx-font-size: 15; -fx-text-fill: #34495e; -fx-line-spacing: 5;" text="Class description will appear here..." wrapText="true" />
                                    </children>
                                </VBox>

                                <!-- Main Content Split -->
                                <HBox spacing="25" VBox.vgrow="ALWAYS">
                                    
                                    <!-- LEFT COLUMN: Task List (Takes remaining space) -->
                                    <VBox spacing="15" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                                        <Label text="Class Tasks" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                        
                                        <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);" VBox.vgrow="ALWAYS">
                                            <children>
                                                <ListView fx:id="tasksListView" VBox.vgrow="ALWAYS" 
                                                          style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5;" />
                                            </children>
                                        </VBox>
                                    </VBox>
                                    
                                    <!-- RIGHT COLUMN: Actions & Form (Fixed Width) -->
                                    <VBox spacing="25" prefWidth="350">
                                        
                                        <!-- CARD: Actions (Edit/Delete Selected) -->
                                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);">
                                            <children>
                                                <Label text="Manage Selection" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                                <Label text="Select a task from the list to manage it." style="-fx-font-size: 12; -fx-text-fill: #95a5a6;" wrapText="true" />
                                                
                                                <VBox spacing="10">
                                                    <Button fx:id="editTaskButton" onAction="#handleEditTask" text="Edit Selected Task" 
                                                            style="-fx-background-color: #ffa726; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                                                    <Button fx:id="deleteTaskButton" onAction="#handleDeleteTask" text="Delete Selected Task" 
                                                            style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                                                </VBox>
                                            </children>
                                        </VBox>
                                        
                                        <!-- CARD: Add/Edit Form -->
                                        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);">
                                            <children>
                                                <Label fx:id="formTitleLabel" text="Add New Task" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                                
                                                <VBox spacing="5">
                                                    <Label text="Task Title" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d;" />
                                                    <TextField fx:id="taskTitleField" promptText="e.g., Submit Final Project" 
                                                               style="-fx-padding: 12; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd;" />
                                                </VBox>
                                                
                                                <VBox spacing="5">
                                                    <Label text="Description" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d;" />
                                                    <TextArea fx:id="taskDescriptionArea" promptText="Details..." prefRowCount="3" wrapText="true" 
                                                              style="-fx-padding: 12; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd;" />
                                                </VBox>
                                                
                                                <VBox spacing="5">
                                                    <Label text="Due Date" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d;" />
                                                    <DatePicker fx:id="taskDueDatePicker" 
                                                                style="-fx-padding: 8; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd;" />
                                                </VBox>

                                                <HBox spacing="10" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button fx:id="submitTaskButton" onAction="#handleSubmitTask" text="Add Task" HBox.hgrow="ALWAYS" 
                                                                style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" />
                                                        <Button fx:id="cancelEditButton" onAction="#handleCancelEdit" text="Cancel" HBox.hgrow="ALWAYS" 
                                                                style="-fx-background-color: #ecf0f1; -fx-text-fill: #7f8c8d; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold; -fx-cursor: hand;" visible="false" managed="false" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- CARD: Participants -->
                                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label text="Participants" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                                <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f9f9f9; -fx-background-radius: 8; -fx-padding: 5;">
                                                    <ListView fx:id="participantsListView" VBox.vgrow="ALWAYS" 
                                                              style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                                                </VBox>
                                            </children>
                                        </VBox>

                                    </VBox>
                                    
                                </HBox>
                                
                                <!-- Footer Spacer -->
                                <Region prefHeight="20" />
                                
                            </VBox>
                        </HBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>