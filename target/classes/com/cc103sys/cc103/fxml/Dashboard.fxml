<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cc103sys.cc103.Controllers.DashboardController"
      stylesheets="@dashboard.css"
      styleClass="root"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <children>

        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>

        <VBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT">
                <children>

                    <Label fx:id="welcomeLabel"
                           text="Welcome back, User!"
                           styleClass="title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button onAction="#goSettings"
                            styleClass="icon-button">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20">
                                <image>
                                    <Image url="@/images/icon-settingsblue.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                </children>
            </HBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">

                <!-- LEFT SIDE -->
                <VBox spacing="20" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

                    <!-- TASK PANEL -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">

                        <Label text="TaskScene" styleClass="title"/>
                        <Label text="Upcoming Deadlines" styleClass="subtitle"/>

                        <HBox spacing="10">
                            <TextField fx:id="taskField" promptText="Enter Task"/>
                            <DatePicker fx:id="taskDate"/>
                            <Button text="Add" onAction="#handleAddTask"/>
                        </HBox>

                        <ListView fx:id="taskList" VBox.vgrow="ALWAYS"/>

                        <Label fx:id="noTaskLabel"
                               text="No activities to accomplish"
                               styleClass="subtitle"
                               visible="false"/>
                    </VBox>

                    <!-- LEADERBOARD -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">
                        <HBox>
                            <Label text="Mini Leaderboard" styleClass="title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="classSelector" promptText="Class"/>
                        </HBox>

                        <ListView fx:id="leaderboardPreview" VBox.vgrow="ALWAYS"/>

                        <Button text="Open Full Leaderboard"
                                onAction="#openLeaderboardScene"/>
                    </VBox>

                </VBox>

                <!-- RIGHT SIDE -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <!-- TIMER -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS"
                          onMouseClicked="#openTimerPopup"
                          styleClass="card">

                        <Label text="Timer Panel" styleClass="title"/>

                        <Label fx:id="timerLabel"
                               text="00:00"/>

                        <Button text="Start" onAction="#handleStartTimer"/>
                    </VBox>

                    <!-- PROGRESS -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">

                        <Label text="Daily Goal Progress" styleClass="title"/>

                        <ProgressBar fx:id="dailyProgressBar" progress="0"/>

                        <Label fx:id="dailyGoalSummary" styleClass="subtitle"/>
                        <Label fx:id="dailyGoalTip" styleClass="subtitle"/>
                    </VBox>

                </VBox>

            </HBox>

        </VBox>

    </children>
</HBox>