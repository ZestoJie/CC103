<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox style="-fx-background-color: #f8fbff;" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.DashboardController">

    <children>
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER" />

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;">
            <content>
                <VBox prefHeight="870.0" prefWidth="1300" spacing="24" style="-fx-background-color: #f8fbff;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="28" left="28" right="28" top="28" />
                    </padding>

                    <!-- Header Section -->
                    <VBox spacing="8">
                        <Label fx:id="welcomeLabel" styleClass="heading-1" text="Welcome back, User!" />
                        <Label styleClass="subtitle" text="Here's what's happening with your tasks today" />
                    </VBox>

                    <!-- Quick Actions Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button onAction="#goSettings" styleClass="button-secondary" text="Settings" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Main Content Grid -->
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <!-- Left Column - Tasks -->
                        <VBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                            <!-- My Tasks Card -->
                            <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                                <VBox spacing="6">
                                    <Label styleClass="heading-3" text="My Tasks" />
                                    <Label styleClass="subtitle" text="Tasks assigned to you this week" />
                                </VBox>

                                <Separator styleClass="separator" />

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox spacing="8" style="-fx-background-color: transparent;">
                                            <ListView fx:id="taskList" prefHeight="300" style="-fx-padding: 0;" VBox.vgrow="ALWAYS" />
                                            <Label fx:id="noTaskLabel" alignment="CENTER" styleClass="subtitle" text="No activities to accomplish" visible="false" />
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </VBox>

                            <!-- Pending Approvals Card -->
                            <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                                <VBox spacing="6">
                                    <Label styleClass="heading-3" text="Pending Approvals" />
                                    <Label styleClass="subtitle" text="Task submissions waiting for review" />
                                </VBox>

                                <Separator styleClass="separator" />

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <ListView fx:id="pendingApprovalsListView" prefHeight="200" style="-fx-padding: 0;" />
                                    </content>
                                </ScrollPane>
                            </VBox>
                        </VBox>

                        <!-- Right Column - Stats & Leaderboard -->
                        <VBox prefWidth="300" spacing="20" HBox.hgrow="ALWAYS">

                            <!-- Quick Stats Card -->
                            <VBox spacing="16" styleClass="card">
                                <Label styleClass="heading-3" text="Quick Stats" />
                                <Separator styleClass="separator" />

                                <HBox alignment="TOP_LEFT" spacing="12">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label styleClass="caption" text="Total Tasks" />
                                        <Label fx:id="totalTasksLabel" styleClass="heading-2" text="0" />
                                    </VBox>
                                </HBox>

                                <HBox alignment="TOP_LEFT" spacing="12">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label styleClass="caption" text="Completed" />
                                        <Label fx:id="completedTasksLabel" style="-fx-text-fill: #16a34a;" styleClass="heading-2" text="0" />
                                    </VBox>
                                </HBox>

                                <HBox alignment="TOP_LEFT" spacing="12">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label styleClass="caption" text="Pending" />
                                        <Label fx:id="pendingTasksLabel" style="-fx-text-fill: #ca8a04;" styleClass="heading-2" text="0" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- Leaderboard Preview Card -->
                            <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                                <VBox spacing="6">
                                    <Label styleClass="heading-3" text="Top Performers" />
                                    <Label styleClass="subtitle" text="Class leaderboard ranking" />
                                </VBox>

                                <Separator styleClass="separator" />

                                <ComboBox fx:id="classSelector" promptText="Select class" />

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <ListView fx:id="leaderboardPreview" prefHeight="200" style="-fx-padding: 0;" />
                                    </content>
                                </ScrollPane>

                                <Button onAction="#openLeaderboardScene" text="View Full Leaderboard" />
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</HBox>
