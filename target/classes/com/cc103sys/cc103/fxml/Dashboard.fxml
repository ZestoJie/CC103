<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.DashboardController">
    <Label fx:id="welcomeLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="18.0" prefWidth="1440.0" styleClass="title" textAlignment="CENTER" />
    <HBox alignment="CENTER" spacing="20">
       <fx:include source="navbar.fxml" />
        <VBox spacing="15" styleClass="card">
            <HBox spacing="10">
                <TextField fx:id="taskField" promptText="Enter Task" />
                <DatePicker fx:id="taskDate" />
                <Button onAction="#handleAddTask" text="Add Task" />
            </HBox>
   
            <ListView fx:id="taskList" prefHeight="350" prefWidth="400" />
   
            <HBox spacing="10">
                <Button onAction="#handleMarkDone" text="Mark Done" />
                <Button onAction="#handleMarkUndone" text="Mark Undone" />
                <Button onAction="#handleDeleteTask" text="Delete Task" />
            </HBox>
   
        </VBox>
        <VBox spacing="20">

        <VBox spacing="10" styleClass="card">
            <Label styleClass="title" text="Game Timer" />
            <ComboBox fx:id="timerPreset" />
            <Label fx:id="timerLabel" text="00:00" />
            <Button onAction="#handleStartTimer" text="Start Timer" />
        </VBox>
        
        <VBox spacing="10" styleClass="card">
            <Label styleClass="title" text="Leaderboard Preview" />
            <ComboBox fx:id="classSelector" promptText="Select Class" />

            <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="150">
                <content>
                    <ListView fx:id="leaderboardPreview" prefHeight="150" />
                </content>
            </ScrollPane>
            <Button onAction="#openLeaderboardScene" text="Open Full Leaderboard" />
        </VBox>
        
        </VBox>
    </HBox>
</VBox>
