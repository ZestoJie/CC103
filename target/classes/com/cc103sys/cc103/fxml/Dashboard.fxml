<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox fx:id="rootPane" spacing="0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cc103sys.cc103.Controllers.DashboardController"
      styleClass="root">

    <children>

        <!-- Navbar -->
        <fx:include source="navbar.fxml"/>

        <!-- MAIN -->
        <VBox spacing="0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 20 0;">
                <children>
                    <Label fx:id="welcomeLabel" styleClass="title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#goSettings" styleClass="icon-button">
                        <graphic>
                            <ImageView fitHeight="24" fitWidth="24">
                                <Image url="@/images/icon-settingsblue.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                </children>
            </HBox>

            <!-- CONTENT -->
            <HBox spacing="25" VBox.vgrow="ALWAYS">

                <!-- LEFT -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <VBox styleClass="card" VBox.vgrow="ALWAYS">
                        <children>

                            <HBox spacing="10">
                                <Label text="My Tasks" styleClass="title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="classSelector"/>
                            </HBox>

                            <ListView fx:id="taskList" VBox.vgrow="ALWAYS"/>

                            <HBox fx:id="addTaskFooter" spacing="10">
                                <TextField fx:id="taskField" promptText="New Task"/>
                                <DatePicker fx:id="taskDate"/>
                                <Button fx:id="addTaskButton"
                                        text="Add"
                                        onAction="#handleAddTask"
                                        styleClass="button"/>
                            </HBox>

                        </children>
                    </VBox>
                </VBox>

                <!-- RIGHT -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <!-- TIMER -->
                    <VBox fx:id="timerCard" styleClass="card">
                        <children>
                            <Label text="Focus Timer" styleClass="title"/>
                            <Label fx:id="timerLabel" text="00:00"/>
                            
                            <HBox spacing="10">
                                <Button fx:id="timerStartButton"
                                        text="Start"
                                        onAction="#handleStartTimer"
                                        styleClass="button"/>
                                
                                <Button fx:id="timerPauseButton"
                                        text="Pause"
                                        onAction="#handlePauseTimer"
                                        styleClass="button"/>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- LEADERBOARD -->
                    <VBox fx:id="leaderboardCard" styleClass="card" VBox.vgrow="ALWAYS">
                        <children>
                            <Label text="Class Rank" styleClass="title"/>
                            <ListView fx:id="leaderboardPreview" VBox.vgrow="ALWAYS"/>
                            <Button text="View Full Leaderboard"
                                    onAction="#openLeaderboardScene"
                                    styleClass="button"/>
                        </children>
                    </VBox>

                    <!-- PROGRESS -->
                    <VBox fx:id="progressCard" styleClass="card">
                        <children>
                            <Label text="Daily Productivity" styleClass="title"/>
                            <ProgressBar fx:id="dailyProgressBar"/>
                            <Label fx:id="dailyGoalSummary"/>
                            <Label fx:id="dailyGoalTip" styleClass="subtitle"/>
                        </children>
                    </VBox>

                </VBox>
            </HBox>
        </VBox>
    </children>
</HBox>