<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.LeaderboardController" style="-fx-background-color: #f8fbff;" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
    <children>
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>
        
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS">
            <content>
                <VBox spacing="24" prefWidth="1300" style="-fx-background-color: #f8fbff;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="28" right="28" bottom="28" left="28"/>
                    </padding>
                    <children>
                        <!-- Header -->
                        <VBox spacing="8">
                            <Label text="Leaderboard" styleClass="heading-1" />
                            <Label text="Track rankings and compete with others" styleClass="subtitle" />
                        </VBox>

                        <!-- Class Leaderboard -->
                        <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="6">
                                    <Label text="Class Rankings" styleClass="heading-3" />
                                    <Label text="Top performers in your class" styleClass="subtitle" />
                                </VBox>
                                <Separator styleClass="separator" />
                                
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Select Class:" styleClass="caption" />
                                        <ComboBox fx:id="classComboBox" promptText="Select Class" HBox.hgrow="ALWAYS"/>
                                        <Button text="Load" onAction="#loadLeaderboard" />
                                    </children>
                                </HBox>
                                
                                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="table" visible="false" style="-fx-font-size: 12;">
                                        <columns>
                                            <TableColumn fx:id="usernameCol" text="Student Name" prefWidth="220" />
                                            <TableColumn fx:id="pointsCol" text="Total XP" prefWidth="150" />
                                            <TableColumn fx:id="levelCol" text="Level" prefWidth="100" />
                                        </columns>
                                    </TableView>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- Global Leaderboard -->
                        <VBox spacing="14" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="6">
                                    <Label text="Global Rankings" styleClass="heading-3" />
                                    <Label text="Top performers across all classes" styleClass="subtitle" />
                                </VBox>
                                <Separator styleClass="separator" />
                                
                                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="overallTable" style="-fx-font-size: 12;">
                                        <columns>
                                            <TableColumn fx:id="overallUsernameCol" text="Student Name" prefWidth="220" />
                                            <TableColumn fx:id="overallPointsCol" text="Total XP" prefWidth="150" />
                                            <TableColumn fx:id="overallLevelCol" text="Level" prefWidth="100" />
                                        </columns>
                                    </TableView>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- Footer -->
                        <Button text="Back to Dashboard" onAction="#goBack" styleClass="button-secondary" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</HBox>