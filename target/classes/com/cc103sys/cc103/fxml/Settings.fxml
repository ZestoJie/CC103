<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>

<!-- Root Container: Fills the screen -->
<HBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.cc103sys.cc103.Controllers.SettingsController" 
      style="-fx-background-color: #f0f2f5;">
    <children>
        <!-- Navbar (Fixed Width) -->
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>
        
        <!-- Main Content Area (Grows to fill remaining width) -->
        <VBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
            <!-- Main Padding -->
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>
            
            <children>
                <!-- Page Header -->
                <Label text="Settings" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                    <VBox.margin>
                        <Insets bottom="20" />
                    </VBox.margin>
                </Label>
                
                <!-- Scrollable Content (Grows to fill remaining height) -->
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" 
                            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                    <content>
                        <!-- Container with MaxWidth to prevent stretching on ultrawide screens -->
                        <HBox alignment="TOP_CENTER">
                            <VBox spacing="30" maxWidth="900" HBox.hgrow="ALWAYS" fillWidth="true">
                                
                                <!-- CARD 1: Player Profile -->
                                <VBox spacing="25" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);">
                                    <children>
                                        <Label text="Player Profile" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                        
                                        <!-- Profile Picture Section -->
                                        <HBox spacing="30" alignment="CENTER_LEFT">
                                            <children>
                                                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #eef2f7; -fx-background-radius: 100; -fx-padding: 5;">
                                                    <children>
                                                        <ImageView fx:id="profilePictureImageView" fitHeight="140" fitWidth="140" pickOnBounds="true" preserveRatio="true" 
                                                                   style="-fx-border-radius: 50; -fx-background-radius: 50; -fx-border-color: #fff; -fx-border-width: 4;" />
                                                    </children>
                                                </VBox>
                                                
                                                <VBox spacing="15" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button fx:id="uploadPictureButton" text="Upload New Avatar" onAction="#handleUploadPicture" 
                                                                style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12px 30px; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" />
                                                        <Label text="JPG or PNG. Max 5MB." style="-fx-font-size: 13; -fx-text-fill: #95a5a6;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        
                                        <Separator style="-fx-opacity: 0.3;" />
                                        
                                        <!-- Account Details Form -->
                                        <VBox spacing="20">
                                            <!-- Full Name Row -->
                                            <VBox spacing="8">
                                                <Label text="Full Name" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                                <HBox spacing="15" alignment="CENTER_LEFT">
                                                    <TextField fx:id="fullNameField" HBox.hgrow="ALWAYS" 
                                                               style="-fx-padding: 14; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd; -fx-font-size: 14;" />
                                                    <Button fx:id="editFullNameButton" text="Edit" onAction="#handleEditFullName" 
                                                            style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-background-radius: 8; -fx-padding: 10px 25px; -fx-font-weight: 600; -fx-font-size: 13; -fx-cursor: hand;" />
                                                </HBox>
                                            </VBox>

                                            <!-- Username Row -->
                                            <VBox spacing="8">
                                                <Label text="Username" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                                <HBox spacing="15" alignment="CENTER_LEFT">
                                                    <TextField fx:id="usernameField" HBox.hgrow="ALWAYS" 
                                                               style="-fx-padding: 14; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd; -fx-font-size: 14;" />
                                                    <Button fx:id="editUsernameButton" text="Edit" onAction="#handleEditUsername" 
                                                            style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-background-radius: 8; -fx-padding: 10px 25px; -fx-font-weight: 600; -fx-font-size: 13; -fx-cursor: hand;" />
                                                </HBox>
                                            </VBox>

                                            <!-- Email Row -->
                                            <VBox spacing="8">
                                                <Label text="Email Address" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                                <HBox spacing="15" alignment="CENTER_LEFT">
                                                    <TextField fx:id="emailField" HBox.hgrow="ALWAYS" 
                                                               style="-fx-padding: 14; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd; -fx-font-size: 14;" />
                                                    <Button fx:id="editEmailButton" text="Edit" onAction="#handleEditEmail" 
                                                            style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-background-radius: 8; -fx-padding: 10px 25px; -fx-font-weight: 600; -fx-font-size: 13; -fx-cursor: hand;" />
                                                </HBox>
                                            </VBox>

                                            <!-- Password Row -->
                                            <VBox spacing="8">
                                                <Label text="Password" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                                <HBox spacing="15" alignment="CENTER_LEFT">
                                                    <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" promptText="••••••••" editable="false" 
                                                                   style="-fx-padding: 14; -fx-border-color: #dfe6e9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fdfdfd; -fx-font-size: 14;" />
                                                    <Button fx:id="changePasswordButton" text="Change" onAction="#handleChangePassword" 
                                                            style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-background-radius: 8; -fx-padding: 10px 25px; -fx-font-weight: 600; -fx-font-size: 13; -fx-cursor: hand;" />
                                                </HBox>
                                            </VBox>
                                        </VBox>
                                    </children>
                                </VBox>
                                
                                <!-- CARD 2: System Preferences -->
                                <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 6);">
                                <children>
                                    <Label text="System Preferences" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                                    
                                    <!-- Enable Music -->
                                    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                                        <children>
                                            <Label text="Background Music" style="-fx-font-size: 15; -fx-text-fill: #555;" HBox.hgrow="ALWAYS" />
<ToggleButton onAction="#toggleMusic"
              styleClass="switch">

    <graphic>
        <StackPane prefWidth="48" prefHeight="24">
            
            <Rectangle fx:id="musicTrack" width="48"
                       height="24"
                       arcWidth="999"
                       arcHeight="999"
                       style="-fx-fill: rgba(148,163,184,0.4);" />

            <Circle fx:id="musicThumb" styleClass="thumb"
                    radius="10"
                    translateX="-12"/>
        </StackPane>
    </graphic>

</ToggleButton>
                                        </children>
                                    </HBox>
                                    
                                    <Separator style="-fx-opacity: 0.1;" />
                                    
                                    <!-- Enable SFX -->
                                    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                                        <children>
                                            <Label text="Sound Effects (SFX)" style="-fx-font-size: 15; -fx-text-fill: #555;" HBox.hgrow="ALWAYS" />
                                            <ToggleButton onAction="#toggleSfx"
              styleClass="switch">

    <graphic>
        <StackPane prefWidth="48" prefHeight="24">
            
            <Rectangle fx:id="sfxTrack" width="48"
                       height="24"
                       arcWidth="999"
                       arcHeight="999"
                       style="-fx-fill: rgba(148,163,184,0.4);" />

            <Circle fx:id="sfxThumb" styleClass="thumb"
                    radius="10"
                    translateX="-12"/>
        </StackPane>
    </graphic>

</ToggleButton>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                                            </VBox>
                </HBox>
            </content>
        </ScrollPane>

    </children>
</VBox>
    </children>
</HBox>