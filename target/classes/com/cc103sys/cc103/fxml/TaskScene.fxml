<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cc103sys.cc103.Controllers.TaskController"
      stylesheets="@task.css"
      styleClass="root">

    <children>

        <fx:include fx:id="navbar" source="navbar.fxml"/>

        <VBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <children>

                <Label text="Task Manager" styleClass="page-title"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-clean">
                <ScrollPane ... pannable="true" focusTraversable="false">
                    <content>

                        <HBox alignment="TOP_CENTER">
                            <VBox spacing="25" maxWidth="900">

                                <!-- ADD TASK -->
                                <VBox spacing="15" styleClass="card">
                                    <Label text="Quick Add Task" styleClass="card-title"/>
                                    <HBox spacing="15">
                                        <TextField fx:id="taskField" promptText="Enter task"/>
                                        <DatePicker fx:id="taskDate"/>
                                        <Button fx:id="addTaskBtn" text="Add" onAction="#handleAddTask"/>
                                    </HBox>
                                </VBox>

                                
                                <VBox spacing="10" styleClass="card">
                                    <Label text="Filter View" styleClass="subtitle"/>
                                    <ComboBox fx:id="classFilterComboBox" promptText="Select class"/>
                                </VBox>

                                <!-- LISTS -->
                                <HBox spacing="20">

                                    <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                                        <Label text="All Tasks" styleClass="section-title"/>
                                        <VBox styleClass="card" VBox.vgrow="ALWAYS">
                                            <ListView fx:id="allTaskList" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                    </VBox>

                                    <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                                        <Label text="Class Tasks" styleClass="section-title"/>
                                        <VBox styleClass="card" VBox.vgrow="ALWAYS">
                                            <ListView fx:id="filteredTaskList" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                    </VBox>

                                </HBox>

                                <!-- ACTIONS -->
                                <VBox spacing="15" styleClass="card">
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                
                                    <Label text="Task Actions" styleClass="card-title"/>

                                    <HBox spacing="15">
                                        <Button fx:id="markDoneBtn"
                                                text="Mark Done"
                                                onAction="#handleMarkDone"
                                                styleClass="success-btn"
                                                HBox.hgrow="ALWAYS"/>

                                        <Button fx:id="deleteTaskBtn"
                                                text="Delete"
                                                onAction="#handleDeleteTask"
                                                styleClass="danger-btn"
                                                HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                </VBox>

                            </VBox>
                        </HBox>

                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
