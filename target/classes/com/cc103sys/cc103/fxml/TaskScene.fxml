<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cc103sys.cc103.Controllers.DashboardController" style="-fx-background-color: #ecf0f1;" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <children>
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <children>
                <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>

                <VBox spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Task Manager" style="-fx-font-size: 24; -fx-font-weight: bold;" />

                        <VBox spacing="10">
                            <children>
                                <Label text="Add New Task" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                                <HBox spacing="10">
                                    <children>
                                        <TextField fx:id="taskField" promptText="Enter Task Description" HBox.hgrow="ALWAYS"/>
                                        <DatePicker fx:id="taskDate"/>
                                        <Button text="Add Task" onAction="#handleAddTask" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Label text="Your Tasks" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-radius: 5;">
                            <ListView fx:id="taskList" />
                        </ScrollPane>

                        <HBox spacing="10">
                            <children>
                                <Button text="Mark Done" onAction="#handleMarkDone" HBox.hgrow="ALWAYS"/>
                                <Button text="Delete Task" onAction="#handleDeleteTask" HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
