<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.cc103sys.cc103.Controllers.TaskController" 
      style="-fx-background-color: #f0f2f5;">

    <children>
        <!-- Navbar -->
        <fx:include source="navbar.fxml" HBox.hgrow="NEVER"/>

        <!-- Main -->
        <VBox spacing="0" HBox.hgrow="ALWAYS" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <children>

                <!-- Title -->
                <Label text="Task Manager"
                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Scroll -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">

                    <content>

                        <HBox alignment="TOP_CENTER">
                            <VBox spacing="20" maxWidth="900">

                                <!-- TAB PANE -->
                                <TabPane fx:id="taskTabPane" tabClosingPolicy="UNAVAILABLE">

                                    <!-- ================= TAB 1 ================= -->
                                    <Tab text="My Tasks">

                                        <content>

                                            <VBox spacing="20">

                                                <!-- ADD TASK -->
                                                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                                                    <children>

                                                        <Label text="Quick Add Task"/>

                                                        <HBox spacing="10">
                                                            <children>
                                                                <TextField fx:id="taskField" promptText="Task..."/>
                                                                <ComboBox fx:id="classSelectionComboBox" promptText="Class"/>
                                                                <DatePicker fx:id="taskDate"/>
                                                                <Button fx:id="addTaskBtn" text="Add" onAction="#handleAddTask"/>
                                                            </children>
                                                        </HBox>

                                                    </children>
                                                </VBox>

                                                <!-- FILTER -->
                                                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;">
                                                    <children>
                                                        <Label text="Filter"/>
                                                        <ComboBox fx:id="classFilterComboBox"/>
                                                    </children>
                                                </VBox>

                                                <!-- LISTS -->
                                                <HBox spacing="15">

                                                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                                                        <Label text="All Tasks"/>
                                                        <ListView fx:id="allTaskList" VBox.vgrow="ALWAYS"/>
                                                    </VBox>

                                                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                                                        <Label text="Class Tasks"/>
                                                        <ListView fx:id="filteredTaskList" VBox.vgrow="ALWAYS"/>
                                                    </VBox>

                                                    <!-- INFO PANEL -->
                                                    <VBox spacing="10" HBox.hgrow="ALWAYS">

                                                        <Label text="Task Info"/>

                                                        <TextArea fx:id="taskInstructions" promptText="Instructions..."/>

                                                        <ListView fx:id="attachmentsList"/>

                                                        <Button fx:id="uploadAttachmentBtn"
                                                                text="Upload"
                                                                onAction="#handleUploadAttachment"/>

                                                                                                                                <Label fx:id="timerDisplayLabel" text="00:00"/>

                                                        <ComboBox fx:id="timerDuration"/>

                                                        <Button fx:id="startTimerBtn"
                                                                text="Start Timer"
                                                                onAction="#handleStartTimer"/>

                                                        <Button fx:id="saveTaskInfoBtn"
                                                                text="Save"
                                                                onAction="#handleSaveTaskInfo"/>

                                                    </VBox>

                                                </HBox>

                                                <!-- ACTIONS -->
                                                <HBox spacing="10">
                                                    <children>
                                                        <Button fx:id="markDoneBtn"
                                                                text="Mark Done"
                                                                onAction="#handleMarkDone"/>
                                                        <Button fx:id="deleteTaskBtn"
                                                                text="Delete"
                                                                onAction="#handleDeleteTask"/>
                                                    </children>
                                                </HBox>

                                            </VBox>

                                        </content>
                                    </Tab>

                                    <!-- ================= TAB 2 ================= -->
                                    <Tab fx:id="classManagementTab" text="Class Management">

                                        <content>

                                            <VBox spacing="15">

                                                <Label text="Pending Approvals"/>

                                                <ComboBox fx:id="approvalClassFilterComboBox"/>

                                                <ListView fx:id="pendingApprovalsList" VBox.vgrow="ALWAYS"/>

                                                <HBox spacing="10">
                                                    <children>
                                                        <Button fx:id="approveSelectedBtn"
                                                                text="Approve"
                                                                onAction="#handleApproveSelected"/>
                                                        <Button fx:id="rejectSelectedBtn"
                                                                text="Reject"
                                                                onAction="#handleRejectSelected"/>
                                                    </children>
                                                </HBox>

                                            </VBox>

                                        </content>
                                    </Tab>

                                </TabPane>

                            </VBox>
                        </HBox>

                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</HBox>